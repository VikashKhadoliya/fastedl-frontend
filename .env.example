# FastEDL Environment Configuration Template
# Duplicate this file to .env.local and populate with your verified production values.

# 1. Google Search Console Verification
# Obtain from Search Console -> Settings -> Ownership Verification -> HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=

# 2. Google Analytics 4 Measurement ID
# Format: G-XXXXXXXXXX (Obtain from Google Analytics Admin -> Data Streams)
NEXT_PUBLIC_GA_ID=

# 3. Canonical Domain URL
NEXT_PUBLIC_SITE_URL=https://fastedl.app

# 4. Railway Downloader Backend Proxy / Production API URL
NEXT_PUBLIC_API_URL=https://fastedl-backend-production.up.railway.app
BACKEND_URL=https://fastedl-backend-production.up.railway.app

# 5. Supabase Configuration (Admin Auth, CMS Content & Media Storage)
NEXT_PUBLIC_SUPABASE_URL=https://exxbwpswkokeizixkglt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_WqtGwIzYScJo95NwSiW5MQ_xlPxFgxM
